    USE POWER ;
    SHAPE ABUTMENT ;
    PORT
      LAYER nwell ;
        RECT 0.000 4.110 4.310 7.940 ;
      LAYER met1 ;
        RECT 0.000 7.410 4.310 7.760 ;
    END
  END VDD
  PIN GND
    DIRECTION INOUT ;
    USE POWER ;
    SHAPE ABUTMENT ;
    PORT
      LAYER pwell ;
        RECT 0.320 0.350 3.990 2.900 ;
        RECT 0.000 0.000 4.310 0.350 ;
      LAYER met1 ;
        RECT 0.000 0.000 4.310 0.350 ;
    END
  END GND
  OBS
      LAYER li1 ;
        RECT 0.000 7.410 4.310 7.760 ;
        RECT 0.320 4.290 0.660 7.410 ;
        RECT 1.195 5.475 1.365 7.205 ;
        RECT 1.635 5.735 1.805 7.410 ;
        RECT 2.075 7.005 3.125 7.175 ;
        RECT 2.075 5.475 2.245 7.005 ;
        RECT 2.955 5.735 3.125 7.005 ;
        RECT 1.195 5.305 2.245 5.475 ;
