        RECT 2.070 0.795 2.240 1.570 ;
        RECT 3.040 0.795 3.210 1.570 ;
        RECT 1.100 0.625 3.210 0.795 ;
        RECT 1.100 0.350 1.270 0.625 ;
        RECT 1.585 0.350 1.755 0.625 ;
        RECT 2.070 0.350 2.240 0.625 ;
        RECT 2.555 0.350 2.725 0.625 ;
        RECT 3.040 0.350 3.210 0.625 ;
        RECT 3.650 0.350 3.990 2.900 ;
        RECT 0.000 0.000 4.310 0.350 ;
      LAYER mcon ;
        RECT 0.775 7.495 0.945 7.665 ;
        RECT 1.145 7.495 1.315 7.665 ;
        RECT 1.515 7.495 1.685 7.665 ;
        RECT 1.885 7.495 2.055 7.665 ;
        RECT 2.255 7.495 2.425 7.665 ;
