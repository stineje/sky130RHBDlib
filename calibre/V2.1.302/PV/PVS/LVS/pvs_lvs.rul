    AD = area( nsd_20v_drn ) * 0.5
    PD = perimeter( nsd_20v_drn ) * 0.5
    nrs = 0
    nrd = 0
     ]

device MN ( nmos_de_v20 ) ngate_v20_nom ngate_v20_nom nsd_20v_src nsd_20v_drn pwell_all [ 
