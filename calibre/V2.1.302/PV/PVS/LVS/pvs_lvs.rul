    AS = area( nsd_20v_src ) * 0.5
    PS = perimeter( nsd_20v_src ) * 0.5
    AD = area( nsd_20v_drn ) * 0.5
    PD = perimeter( nsd_20v_drn ) * 0.5
    nrs = 0
    nrd = 0
     ]

