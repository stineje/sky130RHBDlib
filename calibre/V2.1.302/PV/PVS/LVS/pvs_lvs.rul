    AD = area( nsrc_de_12v ) * 0.5
    PD = perimeter( nsrc_de_12v ) * 0.5
    nrs = 0
    nrd = 0
     ]

lvs_check_property MN l l -tolerance 0
lvs_check_property MN w w -tolerance 0
lvs_check_property MN m m -tolerance 0

