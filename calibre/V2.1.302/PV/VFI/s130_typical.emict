via "via4" {
   em_model {
      em_vcwidth 0.07
      em_jmax_dc_avg EQU 1 * 13.5
      em_jmax_dc_rms EQU 1 * 100
      em_jmax_dc_peak EQU 1 * 100             
      em_jmax_ac_peak EQU 1 * 100  
      em_jmax_ac_rms EQU 1 * 100
   } 
}
via "via3" {
   em_model {
      em_vcwidth 0.07
      em_jmax_dc_avg EQU 1 * 9
      em_jmax_dc_rms EQU 1 * 19.8
      em_jmax_dc_peak EQU 1 * 63   
      em_jmax_ac_peak EQU 1 * 63                
      em_jmax_ac_rms EQU 1 * 63
   } 
}
