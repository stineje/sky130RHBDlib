process "s130_typical" {
      background_dielectric_constant 1
      temp_reference  25
   	em_tref 90        
   	em_output_wlt drawn 
   	em_variables  w delta_T    
   	em_conductor_unit mA/um 
   	em_via_area_unit  mA 
	em_via_unit mA 
}
conductor "ply" {
   em_model {
      em_jmax_dc_avg EQU 1 * 1.1 * ( w - 0.004 ) jmax_factor 105 1.3 110 1.000 115 0.87 120 0.56 125 0.39 L > 10
      em_jmax_dc_avg EQU 4 * 1.1 * ( w - 0.004 ) jmax_factor 105 1.3 110 1.000 115 0.87 120 0.56 125 0.39 L <= 5
      em_jmax_dc_avg EQU 1.5 * 1.1 * ( w - 0.004 ) jmax_factor 105 1.3 110 1.000 115 0.87 120 0.56 125 0.39 L > 5
      em_jmax_dc_peak EQU 22 * ( w - 0.004 ) 
      em_jmax_ac_peak EQU 22 * ( w - 0.004 ) 
      em_jmax_ac_rms EQU sqrt( 20 * delta_T * ( w - 0.004 )^2 * ( w - 0.004 + 0.31 ) / ( w - 0.004 + 0.051 ) ) 
   } 
}
conductor "li" {
   em_model {
      em_jmax_dc_avg EQU 100 * w
      em_jmax_dc_rms EQU 25 * w
      em_jmax_dc_peak EQU 25 * ( w - 0.004 ) 
      em_jmax_ac_peak EQU 25 * ( w - 0.004 ) 
      em_jmax_ac_rms EQU sqrt( 20 * delta_T * ( w - 0.004 )^2 * ( w - 0.004 + 0.31 ) / ( w - 0.004 + 0.051 ) ) 
   } 
}
conductor "m1" {
   em_model {
      em_jmax_dc_avg EQU 9 * w
      em_jmax_dc_rms EQU 19.8 * w
      em_jmax_dc_peak EQU 63 * w 
      em_jmax_ac_peak EQU 63 * ( w - 0.004 ) 
      em_jmax_ac_rms EQU sqrt( 20 * delta_T * ( w - 0.004 )^2 * ( w - 0.004 + 0.31 ) / ( w - 0.004 + 0.051 ) ) 
   } 
}
conductor "m2" {
   em_model {
      em_jmax_dc_avg EQU 9 * w
      em_jmax_dc_rms EQU 19.8 * w
      em_jmax_dc_peak EQU 63 * w             
      em_jmax_ac_peak EQU 63 * ( w - 0.004 ) 
      em_jmax_ac_rms EQU sqrt( 20 * delta_T * ( w - 0.004 )^2 * ( w - 0.004 + 0.31 ) / ( w - 0.004 + 0.051 ) )
   } 
}
