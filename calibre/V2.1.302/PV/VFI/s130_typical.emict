      em_jmax_dc_rms EQU 19.8 * w
      em_jmax_dc_peak EQU 63 * w             
      em_jmax_ac_peak EQU 63 * ( w - 0.004 ) 
      em_jmax_ac_rms EQU sqrt( 20 * delta_T * ( w - 0.004 )^2 * ( w - 0.004 + 0.31 ) / ( w - 0.004 + 0.051 ) )
   } 
}
