verbatim {

//
// Fill checks
//

}

proc fill_no_touch_dwg {lay_list} {

set a 1

foreach lay $lay_list {

  if {${lay} == "diff"} { set lname "diff" }
  if {${lay} == "poly"} { set lname "poly" }
  if {${lay} == "m1"} { set lname "met1" }
  if {${lay} == "m2"} { set lname "met2" }
  if {${lay} == "m3"} { set lname "met3" }
  if {${lay} == "m4"} { set lname "met4" }
  if {${lay} == "m5"} { set lname "met5" }

  if {${lay} == "diff"} { set lay2 "diffii" }
  if {${lay} == "poly"} { set lay2 "polyii" }
  if {${lay} == "m1"} { set lay2 "met1ii" }
  if {${lay} == "m2"} { set lay2 "met2ii" }
  if {${lay} == "m3"} { set lay2 "met3ii" }
  if {${lay} == "m4"} { set lay2 "met4ii" }
  if {${lay} == "m5"} { set lay2 "met5ii" }

RULECHECK fill.OVL.${a} {
   @ fill.OVL.${a}: Layer ${lay}_fill must be outside ${lname}/drawing
   OUTPUT "${lay}_fill AND ${lay2}"
   }

incr a

 }
}

fill_no_touch_dwg [list "diff" "poly" "li" "m1" "m2" "m3" "m4" "m5"]

RULECHECK fill.CON.1 {
   @ fill.CON.1: Layer diff_fill must float
   OUTPUT "(diff_fill NOT (OR critSide ccorner))  INTERACT licon"
   }

RULECHECK fill.CON.2 {
   @ fill.CON.2: Layer poly_fill must float
   OUTPUT "(poly_fill NOT (OR critSide ccorner)) INTERACT licon"
   }

RULECHECK fill.CON.3 {
   @ fill.CON.3: Layer li_fill must float
   OUTPUT "(li_fill NOT (OR critSide ccorner)) INTERACT licon"
   OUTPUT "(li_fill NOT (OR critSide ccorner)) INTERACT mcon"
   }

RULECHECK fill.CON.4 {
   @ fill.CON.4: Layer m1_fill must float
   OUTPUT "(m1_fill NOT (OR critSide ccorner)) INTERACT mcon"
   OUTPUT "(m1_fill NOT (OR critSide ccorner)) INTERACT via1"
   }

RULECHECK fill.CON.5 {
   @ fill.CON.5: Layer m2_fill must float
   OUTPUT "(m2_fill NOT (OR critSide ccorner)) INTERACT via1"
   OUTPUT "(m2_fill NOT (OR critSide ccorner)) INTERACT via2"
   }

RULECHECK fill.CON.6 {
   @ fill.CON.6: Layer m3_fill must float
   OUTPUT "(m3_fill NOT (OR critSide ccorner)) INTERACT via2"
   OUTPUT "(m3_fill NOT (OR critSide ccorner)) INTERACT via3"
   }

RULECHECK fill.CON.7 {
   @ fill.CON.7: Layer m4_fill must float
   OUTPUT "(m4_fill NOT (OR critSide ccorner)) INTERACT via3"
   OUTPUT "(m4_fill NOT (OR critSide ccorner)) INTERACT via4"
   }

RULECHECK fill.CON.8 {
   @ fill.CON.8: Layer m5_fill must float
   OUTPUT "m5_fill INTERACT via4"
   }

verbatim {

//
// viatop checks
//

}

set exact_size_viatop       1.0
set min_space_viatop        1.2
set min_enc_viatop_m5       0.4
set min_space_viatop_pad   10.0
set min_space_viatop_via4   0.2

RULECHECK viatop.WID.1 {
   @ viatop.WID.1: min and max L and W of viatop = ${exact_size_viatop}
   OUTPUT "NOT RECTANGLE viatop == ${exact_size_viatop} BY == ${exact_size_viatop} ORTHOGONAL ONLY"
   }

RULECHECK viatop.SP.1 {
   @ viatop.SP.1: min spacing of viatop < ${min_space_viatop}
   OUTPUT "EXT viatop < ${min_space_viatop} ABUT<90 REGION"
   }

# Rule viatop.3 is covered by viatop.WID.1

RULECHECK viatop.ENC.1 {
   @ viatop.ENC.1: Min enclosure of viatop by met5 <  ${min_enc_viatop_m5}
   OUTPUT "ENC viatop met5 < ${min_enc_viatop_m5} ABUT<90 SINGULAR REGION"
   OUTPUT "viatop NOT met5"
   }

RULECHECK viatop.CON.1 {
   @ viatop.CON.1: viatop must not be placed over pad
   OUTPUT "viatop AND pad"
   }

RULECHECK viatop.SP.2 {
   @ viatop.SP.2: min spacing of viatop to pad < ${min_space_viatop_pad}
   OUTPUT "EXT viatop pad < ${min_space_viatop_pad} ABUT<90 REGION SINGULAR"
   }

RULECHECK viatop.CON.2 {
   @ viatop.CON.2: viatop must not be placed over via4
   OUTPUT "viatop AND via4"
   }

RULECHECK viatop.SP.3 {
   @ viatop.SP.3: min spacing of viatop to via4 < ${min_space_viatop_via4}
   OUTPUT "EXT viatop via4 < ${min_space_viatop_via4} ABUT<90 REGION SINGULAR"
   }

verbatim {

//
// mtest checks
//

}

set min_wid_mtest       1.0
set min_space_mtest        1.0
set min_enc_viatop_mtest   0.4

RULECHECK mtest.CON.1 {
   @ mtest.CON.1: layer cmtest/drawing is for SkyWater Technology internal use only
   OUTPUT "COPY mtest"
   }

RULECHECK mtest.WID.1 {
   @ mtest.WID.1: min width of mtest = ${min_wid_mtest}
   OUTPUT "INT mtest < ${min_wid_mtest} ABUT<90 REGION"
   }

RULECHECK mtest.SP.1 {
   @ mtest.SP.1: min spacing of mtest < ${min_space_mtest}
   OUTPUT "EXT mtest < ${min_space_mtest} ABUT<90 REGION"
   }

RULECHECK mtest.ENC.1 {
   @ mtest.ENC.1: Min enclosure of viatop by mtest <  ${min_enc_viatop_mtest}
   OUTPUT "ENC viatop mtest < ${min_enc_viatop_mtest} ABUT<90 SINGULAR REGION"
   OUTPUT "viatop NOT mtest"
   }

//
// r1c checks
//

set r1c_min_wid 0.32
set r1c_max_len 0.32
set r1c_min_space 0.14
set via_min_enc_r1c 0.085

RULECHECK r1c.WID.1 {
   @ r1c.WID.1: Min width of r1c < ${r1c_min_wid}
   OUTPUT "INT r1c < ${r1c_min_wid} ABUT<90 REGION"
   }

RULECHECK r1c.LEN.1 {
   @ r1c.LEN.1: Max LENGTH of r1c > ${r1c_max_len}
    OUTPUT "r1c WITH EDGE (LENGTH r1c > ${r1c_max_len})"
   }

RULECHECK r1c.SP.1 {
   @ r1c.SP.1: Min space of r1c < ${r1c_min_space}
   OUTPUT "EXT r1c < ${r1c_min_space} ABUT<90 REGION"
   }

RULECHECK r1c.CON.1 {
   @ r1c.CON.1: Only square r1c are allowed
   SETLAYER good = "RECTANGLE r1c == ${r1c_min_wid} ASPECT == 1"
   OUTPUT "r1c NOT good"
}

RULECHECK r1c.ENC.1 {
   @ r1c.ENC.1: min enclosure of via1 by r1c < ${via_min_enc_r1c}
   OUTPUT "ENC via1 r1c < ${via_min_enc_r1c} ABUT<90 REGION SINGULAR"
   OUTPUT "r1c INSIDE EDGE via1"
}
