@ via2.WID.1: Min via2 width outside areaid:moduleCut < ${min_wid_via2_outs_mt}
   OUTPUT "INT (via2 NOT moduleCutAREA) < ${min_wid_via2_outs_mt} ABUT<90 REGION"
   }

RULECHECK via2.LEN.1 {
