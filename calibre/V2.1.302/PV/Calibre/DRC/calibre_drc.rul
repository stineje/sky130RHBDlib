# JAG 7/8/21 removed as duplicate of dnwell.CON.4:
#RULECHECK dnwell_missing_nwell.1 {
#@ dnwell_missing_nwell.1: dnwell missing nwell connectection
#  OUTPUT "dnwell NOT INTERACT nwell"
