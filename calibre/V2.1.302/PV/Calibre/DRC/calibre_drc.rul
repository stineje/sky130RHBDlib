@ floating.net.met4.R: Floating met4 nets - nets which do not connect to a defined device
  OUTPUT "COPY ((bad_m4 NOT m4_fill) NOT exempt_float_m4)"
}

SETLAYER exempt_float_m5 = "met5ii INSIDE CELL \"text_pcell*\""
