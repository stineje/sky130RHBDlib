mm4WaffleArea = waffleChpBnd NOT (SIZE mm4Waff BY 1.15 OVERUNDER)
mm4_DFMwaffle = DFM FILL mm4
DFM SPEC FILL mm4 mm4Oxide [ ( AREA(mm4Oxide) + AREA(_FILL_) ) / AREA() ]  
