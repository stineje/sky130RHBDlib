//  DESCRIPTION
//  Calibre Metal Fill Generation rule for S130 PDK V1
//  
//  Revision History
//  vun 05/21/20 adapted from S8 PDK V2.0
//  jag 02/22/22 changed SNAP value to 5 for MM1/2
//               changed output fill name to "fill.gds" from "fill.db"
//               increased STEP value to avoid spacing issues
//               added SETBACK commands to avoid spacing issues
//               commented out FILL SPEC sections to avoid min area and other DRC errors
//               added APPEND "_fill" to output cell names
//               added (squared-off) pad setback for m4/m5
    
// ********************************************************
// Begin control statements
// ********************************************************
//LAYOUT PATH  "top_cell.calibre.db"
//LAYOUT PRIMARY "top_cell"
//LAYOUT SYSTEM GDSII

PRECISION 1000

UNIT LENGTH u

DRC ICSTATION YES

DRC MAXIMUM RESULTS ALL

// Tolerance for round-off errors on skew edges
DRC TOLERANCE FACTOR 0.001

// ********************************************************
// End control statements
// ********************************************************

// ********************************************************
// Begin layer definitions
// ********************************************************

