	 FILLSHAPE 0 0 2 2 STEP 0.32 EFFORT 1 
		 SPACE 3 mm3WaffleKO 
		 SPACE 3.3 fuse 
		 SPACE 0 inductor_metal 
		 SPACE 3 capacitor 
		 SPACE 0 scribeKeepout 
		 SHAPESPACE 0.34 
                 SETBACK 0.34
	 FILLSHAPE 0 0 1 1 STEP 0.32 EFFORT 1 
		 SPACE 3 mm3WaffleKO 
		 SPACE 3.3 fuse 
		 SPACE 0 inductor_metal 
		 SPACE 3 capacitor 
		 SPACE 0 scribeKeepout 
		 SHAPESPACE 0.34 
                 SETBACK 0.34
	 FILLSHAPE 0 0 0.58 0.58 STEP 0.32 EFFORT 1 
		 SPACE 0.5 mm3WaffleKO 
		 SPACE 3.3 fuse 
		 SPACE 0 inductor_metal 
		 SPACE 3 capacitor 
		 SPACE 0 scribeKeepout 
		 SHAPESPACE 0.34 
                 SETBACK 0.34
//	 FILLSHAPE 0 0 0.4 0.4 STEP 0.3 EFFORT 1 
//		 SPACE 0.5 mm3WaffleKO 
//		 SPACE 3.3 fuse 
//		 SPACE 0 inductor_metal 
//		 SPACE 3 capacitor 
//		 SPACE 0 scribeKeepout 
//		 SHAPESPACE 0.34 
