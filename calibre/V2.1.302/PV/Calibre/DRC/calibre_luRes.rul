LU4_PSRCDRNspNtr = NOT INTERACT (NET AREA RATIO PSRCDRN LU4_ioPad > 0) ENID
LU4_NTAPspNtr = NOT INTERACT (NET AREA RATIO NTAP LU4_ioPad > 0) ENID
