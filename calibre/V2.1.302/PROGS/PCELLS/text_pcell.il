			)
		    ) 
		    case(characterWidth 
			("norm" 
			    (pntr = (pntr + (magAmount * dspace)))
			) 
			("wide" 
			    (pntr = (pntr + (magAmount * dspace * 1.2)))
			) 
			("narrow" 
			    (pntr = (pntr + (magAmount * dspace * 0.6)))
			)
		    )
		) 
		(haloBox = list(rodAddPoints(xCoord((pcCellView~>bBox)) 
			    list((- halo_distance) 
				(- halo_distance)
			    )
			) 
			rodAddPoints(yCoord((pcCellView~>bBox)) 
			    list(halo_distance halo_distance)
			)
		    )) 
		if(pc_layer == "active"
		    dbCreateRect( pcCellView "pwblk" haloBox)
			)
		if(pc_layer == "active"
		    dbCreateRect( pcCellView "rhstiswblk" haloBox)
		        )
	    )
	) 
	return(t)
    )
