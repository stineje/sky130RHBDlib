pcDefinePCell(
list(ddGetObj("S130") "text_pcell" "layout")
(
  (text string "abc")
  (halo_distance float 1.000000e+00)
  (text_mag float 1.000000e+00)
  (text_layer string "met1")
)
    prog((_pcParameters text_layer text halo_distance text_mag 
	) 
	if(!pcCellView 
	    return()
	) 
	(_pcParameters = (pcCellView~>parameters)) 
	(text_layer = (_pcParameters~>text_layer)) 
	if(!stringp(text_layer) then 
	    (text_layer = "y1")
	)
	(text = (_pcParameters~>text)) 
	if(!stringp(text) then 
	    (text = "test")
	) 
	(halo_distance = (_pcParameters~>halo_distance)) 
	if(!halo_distance then 
	    (halo_distance = 1.0)
	) 
	if(!floatp(halo_distance) then 
	    (halo_distance = 1.0)
	)
	(text_mag = (_pcParameters~>text_mag)) 
	if(!text_mag then 
	    (text_mag = 1.0)
	) 
	if(!floatp(text_mag) then 
	    (text_mag = 1.0)
	)
	let((text_mag pc_mag pc_mag0 pc_mag0offset text
		text1 text1offset pc_layer pc_layer2 pc_layer2offset
		pcMember pcStretchGroup stretchOffsetX stretchOffsetY pcLib
		pcMaster pcInst pcTerm pcPin pcPinName
		pcNet pcTermNet pcNetName pcTermNetName pcMosaicInst
		tpcParameters pcParamProp pcStep pcStepX pcStepY
		pcRepeat pcRepeatX pcRepeatY pcIndexX pcIndexY
		pcLayer pcPurpose pcLabelText pcLabelHeight pcPropText
		pcParamText pcCoords pcPathWidth pcPolygonMargin halo_distance
		haloBox
	    ) 
	    (pcLib = (pcCellView~>lib)) 
	    (pcParameters = ((pcCellView~>parameters)~>value)) 
	    (pcParamProp = car(exists(prop pcParameters 
			((prop~>name) == "halo_distance")
		    )
		)) 
	    (halo_distance = (pcParamProp~>value))
	    (pcParamProp = car(exists(prop pcParameters 
			((prop~>name) == "text_mag")
		    )
		)) 
	    (text_mag = (pcParamProp~>value)) 
	    if(((pcParamProp~>valueType) == "boolean") 
		(text_mag = (text_mag == "TRUE"))
	    ) 
	    (pcParamProp = car(exists(prop pcParameters 
			((prop~>name) == "text")
		    )
		)) 
	    (text = (pcParamProp~>value))
	    if(((pcParamProp~>valueType) == "boolean") 
		(text = (text == "TRUE"))
	    ) 
	    (pcParamProp = car(exists(prop pcParameters 
			((prop~>name) == "text_layer")
		    )
		)) 
	    (text_layer = (pcParamProp~>value)) 
	    if(((pcParamProp~>valueType) == "boolean") 
		(text_layer = (text_layer == "TRUE"))
	    ) 
	    (pc_mag = text_mag)
	    if((pc_mag == nil) 
		(pc_mag = 1.0)
	    ) 
	    (techFile = techGetTechFile(pcCellView)) 
	    (pc_layer = text_layer) 
	    if((pc_layer == nil) 
		(pc_layer = "y1")
	    ) 
	    if((text == nil) 
		(text = "test")
	    )
	    (pc_mag0 = pc_mag) 
	    (text1 = sprintf(text "%s" text)) 
	    (text1 = lowerCase(text1)) 
	    (text = lowerCase(text)) 
	    (pc_layer2 = pc_layer)
	    if((pc_mag0 == nil) 
		(pc_mag0 = 0.0)
	    ) 
	    (pc_mag0offset = (pc_mag0 - 1.1)) 
	    (pcPropText = errset(text)) 
	    if(pcPropText then 
		(pcPropText = pcExprToProp(car(pcPropText))) 
		dbReplaceProp(pcCellView "text" 
		    car(pcPropText) 
		    cadr(pcPropText)
		)
	    ) 
	    (pcPropText = errset(pc_layer))
	    if(pcPropText then 
		(pcPropText = pcExprToProp(car(pcPropText))) 
		dbReplaceProp(pcCellView "text_layer" 
		    car(pcPropText) 
		    cadr(pcPropText)
		)
	    ) 
	    (pcPropText = errset(pc_mag)) 
	    if(pcPropText then 
		(pcPropText = pcExprToProp(car(pcPropText))) 
		dbReplaceProp(pcCellView "text_mag" 
		    car(pcPropText) 
		    cadr(pcPropText)
		)
	    ) 
	    (text_string = text) 
	    (magAmount = pc_mag)
	    (layerField = pc_layer) 
	    (pcLayer = layerField) 
	    (pcPurpose = "drawing") 
	    if((techGetLP(techFile 
			list(pcLayer pcPurpose)
		    ) == nil) then 
		printf("Layer: %L Purpose: %L is not a vaild layer/purpose pair in this technology" pcLayer pcPurpose) else 
		(dspace = 2)
		(sspace = 5.0) 
		(crds = (0:0)) 
		(pntr = car(crds)) 
		(pntr1 = cadr(crds)) 
		(mtextString = parseString(text_string ""))
