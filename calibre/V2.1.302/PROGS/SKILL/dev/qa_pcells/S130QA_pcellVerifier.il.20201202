;-----------------------------
; Get LVS Match results
;-----------------------------
procedure( S130QA_getLVSResults( cellName verifDir runTool )
  let( (resultsFile passCmd passResult failCmd failResult noRunCmd noRunResult
        lvsStatus resultsPort nextLine lvsError lvsErrors )

    lvsStatus = "N/A"
    lvsErrors = list()

    case( runTool
      ("Calibre"
        resultsFile = strcat(verifDir "/" cellName ".lvs.report")
        if( isFile(resultsFile) then
          passCmd = sprintf(nil "grep -c '#     CORRECT     #' %s" resultsFile)
          passResult = evalstring(S130QA_unixCmd(passCmd)) 
          failCmd = sprintf(nil "grep -c '#     INCORRECT     #' %s" resultsFile)
          failResult = evalstring(S130QA_unixCmd(failCmd)) 
          noRunCmd = sprintf(nil "grep -c '#     NOT COMPARED     #' %s" resultsFile)
          noRunResult = evalstring(S130QA_unixCmd(noRunCmd)) 
          if( noRunResult > 0 then
            lvsStatus = "** NOT COMPARED **"
          else
            cond(
              ;( rexMatchp("_pass$" cellName) && passResult > 0 lvsStatus = "PASS" )
              ;( rexMatchp("_pass$" cellName) && failResult > 0 lvsStatus = "FAIL" )
              ;( rexMatchp("_fail$" cellName) && passResult > 0 lvsStatus = "FAIL" )
              ;( rexMatchp("_fail$" cellName) && failResult > 0 lvsStatus = "PASS" )
              ( passResult > 0 lvsStatus = "CORRECT" )
              ( failResult > 0 lvsStatus = "INCORRECT" )
            ); cond
            resultsPort = infile(resultsFile)
            when( resultsPort 
              while( gets( nextLine resultsPort ) 
                rexCompile("Error: +.*\\( (see below)\\).")
                nextLine = rexReplace( nextLine "" 1)
                rexCompile("Error: +\\(.*\\).")
                when( rexExecute(nextLine)
                  lvsError = rexSubstitute("\\1")
                  unless( member(lvsError lvsErrors)
                    lvsErrors = append1(lvsErrors lvsError)
                  )
                ); when error found
              ); while resultsPort 
              close( resultsPort ) 
            ); when resultsPort
          ); if noRunResult
        else
          lvsStatus = "** FAILED TO RUN **"
        ); if resultsFile
      )
      ("PVS"
        resultsFile = strcat(verifDir "/" cellName ".lvsrpt.cls")
        if( isFile(resultsFile) then
          passCmd = sprintf(nil "grep -c 'Run Result *: *MATCH' %s" resultsFile)
          passResult = evalstring( S130QA_unixCmd(passCmd) ) 
          failCmd = sprintf(nil "grep -c 'Run Result *: *MISMATCH' %s" resultsFile)
          failResult = evalstring( S130QA_unixCmd(failCmd) ) 
          cond(
            ;( rexMatchp("_pass$" cellName) && passResult > 0 lvsStatus = "PASS" )
            ;( rexMatchp("_pass$" cellName) && failResult > 0 lvsStatus = "FAIL" )
            ;( rexMatchp("_fail$" cellName) && passResult > 0 lvsStatus = "FAIL" )
            ;( rexMatchp("_fail$" cellName) && failResult > 0 lvsStatus = "PASS" )
            ( passResult > 0 lvsStatus = "MATCH" )
            ( failResult > 0 lvsStatus = "MISMATCH" )
          ); cond
          resultsPort = infile(resultsFile)
          when( resultsPort 
            while( gets( nextLine resultsPort ) 
              rexCompile("# *\\(.*\\) MISMATCHES")
              when( rexExecute(nextLine)
                lvsError = rexSubstitute("\\1")
                unless( member(lvsError lvsErrors)
                  lvsErrors = append1(lvsErrors lvsError)
                )
              ); when error found
            ); while resultsPort 
            close( resultsPort ) 
          ); when resultsPort
        else
          lvsStatus = "** FAILED TO RUN **"
        ); if resultFile
      )
    ); case runType

    list( lvsStatus lvsErrors )

  ); let
); procedure S130QA_getLVSResults

;-----------------------------
; Create Calibre DRC Header file
;-----------------------------
procedure( S130QA_createDRCCALheader( cellName verifDir calDRCdeck)
  let( (ruleFile rulePort)
    ruleFile = sprintf(nil "%s/cal.header.rul" verifDir )
    rulePort = outfile(ruleFile)
    fprintf( rulePort
"// +++ CUSTOMIZATION SETTINGS START +++\n
\n
#define \"SKIP_ANTENNA_CHECKS\"\n
#define \"SKIP_DENSITY_CHECKS\"\n
#undefine \"GENERATE_LOCAL_DENSITY\"\n
#undefine \"GENERATE_PREDICTIVE_FILL\"\n
#define \"SKIP_RECOMMENDED_CHECKS\"\n
#define \"SKIP_LATCHUP_CHECKS\"\n
#define \"SKIP_SOFT_CONNECT_CHECKS\"\n
#define \"SKIP_STRESS_CHECKS\"\n
#undefine \"SAVE_CONSTRUCTION_LAYERS\"\n
\n
// +++ CUSTOMIZATION SETTINGS END +++\n
\n
LAYOUT PATH  \"../%s.gds\"\n
LAYOUT PRIMARY \"%s\"\n
LAYOUT SYSTEM GDSII\n
\n
DRC RESULTS DATABASE \"%s.drc.results\" ASCII\n
DRC MAXIMUM RESULTS ALL\n
DRC MAXIMUM VERTEX 4096\n
\n
DRC CELL NAME YES CELL SPACE XFORM\n
DRC SUMMARY REPORT \"%s.drc.summary\" REPLACE\n
DRC CHECK TEXT COMMENTS\n
\n
VIRTUAL CONNECT COLON NO\n
VIRTUAL CONNECT REPORT NO\n
\n
DRC ICSTATION YES\n
\n
INCLUDE \"%s\"\n"
    cellName cellName cellName cellName calDRCdeck )

    close(rulePort)

  ); let
); procedure S130QA_createDRCCALheader

;-----------------------------
; Get DRC Match results
;-----------------------------
procedure( S130QA_getDRCResults( cellName verifDir runTool )
  let( (resultsFile passCmd passResult failCmd failResult
        drcStatus resultsPort nextLine drcError drcErrors temp )

    drcStatus = "N/A"
    drcErrors = list()

    case( runTool
      ("Calibre"
        resultsFile = strcat(verifDir "/" cellName ".drc.summary")
        if( isFile(resultsFile) then
          passCmd = sprintf(nil "grep -c '^TOTAL DRC Results Generated: *0$' %s" resultsFile)
          passResult = evalstring(S130QA_unixCmd(passCmd)) 
          failCmd = sprintf(nil "grep -c '^TOTAL DRC Results Generated: *[1-9]' %s" resultsFile)
          failResult = evalstring(S130QA_unixCmd(failCmd)) 
          cond(
            ;( rexMatchp("_pass$" cellName) && passResult > 0 drcStatus = "PASS" )
            ;( rexMatchp("_pass$" cellName) && failResult > 0 drcStatus = "FAIL" )
            ;( rexMatchp("_fail$" cellName) && passResult > 0 drcStatus = "FAIL" )
            ;( rexMatchp("_fail$" cellName) && failResult > 0 drcStatus = "PASS" )
            ( passResult > 0 drcStatus = "CORRECT" )
            ( failResult > 0 drcStatus = "INCORRECT" )
          ); cond
          resultsPort = infile(resultsFile)
          when( resultsPort 
            while( gets( nextLine resultsPort ) 
              temp = pcreCompile("RULECHECK (\\S+).* TOTAL Result Count = ([1-9]\\d*)$")
              when( pcreExecute(temp nextLine)
                drcError = pcreSubstitute("\\1: \\2")
                unless( member(drcError drcErrors)
                  drcErrors = cons(drcError drcErrors)
                )
              ); when error found
            ); while resultsPort 
            close( resultsPort ) 
          ); when resultsPort
        else
          drcStatus = "** FAILED TO RUN **"
        ); if resultsFile
      )
      ("PVS"
        resultsFile = strcat(verifDir "/result.sum")
        if( isFile(resultsFile) then
          passCmd = sprintf(nil "grep -c '^Total DRC Results *: *0' %s" resultsFile)
          passResult = evalstring(S130QA_unixCmd(passCmd)) 
          failCmd = sprintf(nil "grep -c '^Total DRC Results *: *[1-9]' %s" resultsFile)
          failResult = evalstring(S130QA_unixCmd(failCmd)) 
          cond(
            ;( rexMatchp("_pass$" cellName) && passResult > 0 drcStatus = "PASS" )
            ;( rexMatchp("_pass$" cellName) && failResult > 0 drcStatus = "FAIL" )
            ;( rexMatchp("_fail$" cellName) && passResult > 0 drcStatus = "FAIL" )
            ;( rexMatchp("_fail$" cellName) && failResult > 0 drcStatus = "PASS" )
            ( passResult > 0 drcStatus = "MATCH" )
            ( failResult > 0 drcStatus = "MISMATCH" )
          ); cond
          resultsPort = infile(resultsFile)
          when( resultsPort 
            while( gets( nextLine resultsPort ) 
              temp = pcreCompile("RULECHECK (\\S+).* Total Result *([1-9]\\d*) ")
              when( pcreExecute(temp nextLine)
                drcError = pcreSubstitute("\\1: \\2")
                unless( member(drcError drcErrors)
                  drcErrors = cons(drcError drcErrors)
                )
              ); when error found
            ); while resultsPort 
            close( resultsPort ) 
          ); when resultsPort
        else
          drcStatus = "** FAILED TO RUN **"
        ); if resultFile
      )
    ); case runType

    list( drcStatus drcErrors )

  ); let
); procedure S130QA_getDRCResults

;-----------------------------
; Run UNIX command and return results
;-----------------------------
procedure( S130QA_unixCmd( cmd )
  prog( (id out results)
    id = ipcBeginProcess(cmd)
    ipcWaitForProcess(id)
    out = ipcReadProcess(id 10)
    results = car(parseString(out "\n"))
    ipcKillProcess(id)
    return(results)
  ); prog
); procedure S130QA_unixCmd

;-----------------------------
; procedure S130QA_PcVerifHelp
;-----------------------------
procedure( S130QA_PcVerifHelp()

  hiDisplayAppDBox(
    ?name         'formHelp
    ?dboxBanner   "*** S130 QA Tool Help ***" 
    ?dboxText     strcat( 
      "====================================================================================================\n"
      "\n" 
      "CAUTION:  HIGH NUMBER OF PLACEMENTS > 5K CAN TAKE A LONG TIME TO COMPLETE, AND COULD\n"
      "          ALSO CAUSE MEMORY ISSUES, EVEN CRASH YOUR CADENCE SESSION\n"
      "\n" 
      "====================================================================================================\n"
      "\n" 
      "This tool will create a layout and/or schematic view for the lib/cell choosen on the form.\n"
      "It will then place a number of instances of the pcell choosen in those views with the pcell\n"
      "parameters varied based on which parameters are enabled and their set values on the form.\n"
      "\n"
      "Next it will run the desired verification using the desired tool and use the rule decks\n"
      "from the form.  All the run data is placed in the root run directory under the cell name\n"
      "and type of run (lvs/drc).\n"
      "\n" 
      "A report (QAPcellVerif_[cell].report) is created in your work area and displayed in a\n"
      "terminal window which summarizes the results of the run(s) performed.\n"
      "\n" 
      "----------------------------------------------------------------------------------------------------\n"
      "\n" 
      "Pcell Variations:\n"
      "\n" 
      "Choose which pcell you would like to test from the \"Place Pcell\" pulldown\n"
      "The checkbox to the left of the parameter name enables or disables the use of the\n"
      "parameter to create variants for it.\n"
      "\n"
      "For parameters that values can be entered, there will be a min, max, and step field\n"
      "  to fill in.\n"
      "For parameters that choices can be made (pulldowns & radio buttons), all choices will\n"
      "  be avaible to choose; check the box next to those you want to test.\n"
      "For boolean parameters, there are no choices other than enabling it, which till toggle\n"
      "  them on and off in the variations.\n"
      "\n"
      "====================================================================================================\n"
      "\n"
    )
    ?dialogType   3
    ?dialogStyle  'modeless
    ?buttonLayout 'UserDefined
    ?buttons      list("Thanks!")
  ); end hiDisplayAppDBox

); procedure S130QA_PcVerifHelp

