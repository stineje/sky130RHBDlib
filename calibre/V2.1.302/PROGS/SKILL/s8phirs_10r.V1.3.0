#%Module1.0
#
#   
#   Title       :  Analog pdk module setup file
#   Author      :  bdj (original script apd)
#   Created     :  2017/12/08
#   Description :  Module file to set up PDK variables
###############################################################################
######################## DO NOT EDIT THIS FILE!!! #############################
# This file is meant to setup/cleanup pdk-specific environment variables      #
# and pdk-specific aliases.  This file will also prevent subsequent           #
# loading of pdk-specific modules after an initial pdk-specific               #
# module has been loaded. If changes to the default pdk environment need      #
# to be made please contact the Project Manager                               #
###############################################################################



###############################################################################
#   Informational message
###############################################################################
proc ModulesHelp { } {
    puts stderr "Skywater S8 setup"
    puts stderr ""
    puts stderr ""
  }
 
proc ModulesDisplay { } {
    puts stderr "\n"
    ModulesHelp
}

###############################################################################
# Module Associations
###############################################################################
# Require base
#prereq ...

# Get Module Name
set modName [module-info name]

# Prevent loading of multiple pdk-specific modules
if {[module-info mode load]} {
  if {[is-loaded $modName]} {
    puts stderr "Module: $modName has already been loaded"
    puts stderr "Exiting Module: $modName"
    exit
  } elseif {[is-loaded pdk_loaded]} {
    puts stderr "A pdk-specific module has already been loaded"
    puts stderr "Please unload that module before loading this one"
    puts stderr "Exiting Module: $modName"
    exit
  } else {
    puts stderr "Loading pdk-Specific Module: $modName"
  }
}

if {[module-info mode remove]} {
  puts stderr "Unloading pdk-Specific Module: $modName"
}

# Indicate that this pdk-specific module is loaded
module load pdk_loaded

############################################
# Site-specific PDK Installation Variables #
############################################
setenv SW_PDK_ROOT /vendor_lib/skywater
setenv PDK_HOME $env(SW_PDK_ROOT)/s8/V1.3.0
setenv SW_IP_HOME $env(SW_PDK_ROOT)/s8_ip/
setenv METAL_STACK   "s8phirs_10r"

###################################
# Set S8 specific variables
####################################
setenv PDK_MODEL_HOME $env(PDK_HOME)
setenv DEVICELIB_ROOT $env(PDK_HOME)/VirtuosoOA/libs

setenv TECHDIR $env(PDK_HOME)
setenv TECHDIR_DRC $env(PDK_HOME)/DRC/Calibre
setenv TECHDIR_LVS $env(PDK_HOME)/LVS/Calibre

###################################
# Recommended Cadence env variables
####################################
setenv CDS_Netlisting_Mode Analog
setenv CDS_AUTO_64BIT ALL
setenv CDS_AHDLCMI_ENABLE YES 
#setenv SOS_CDS_EXIT YES
#setenv LBS_BASE_SYSTEM LBS_SGE
setenv CDS_QUIET 0



