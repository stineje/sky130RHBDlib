# Verilog files
set my_verilog_files [glob ./hdl/*]
./hdl/adder.v ./hdl/gcd.v ./hdl/adder.sv ./hdl/aludec_new.sv ./hdl/aludec_orig.sv ./hdl/aludec.sv ./hdl/alu.sv ./hdl/arrs.sv ./hdl/controller.sv ./hdl/counter.sv ./hdl/datapath.sv ./hdl/flopenr.sv ./hdl/flopens.sv ./hdl/flopr.sv ./hdl/magcompare2b.sv ./hdl/magcompare2c.sv ./hdl/magcompare32.sv ./hdl/maindec.sv ./hdl/mux2.sv ./hdl/mux3.sv ./hdl/mux4.sv ./hdl/mux5.sv ./hdl/regfile.sv ./hdl/riscv.sv ./hdl/shifter.sv ./hdl/signext.sv ./hdl/mult.sv
# VHDL files
# set my_vhdl_files [list top.vhd]
# Set toplevel
set my_toplevel mult
mult
# Set number of significant digits
set report_default_significant_digits 6
6
# V(HDL) Unconnectoed Pins Output
set verilogout_show_unconnected_pins "true"
true
set vhdlout_show_unconnected_pins "true"
true
#
# Due to parameterized Verilog must use analyze/elaborate and not 
# read_verilog/vhdl (change to pull in Verilog and/or VHDL)
# to read verilog remove "s"
#
define_design_lib WORK -path ./WORK
1
analyze -f sverilog -lib WORK $my_verilog_files
