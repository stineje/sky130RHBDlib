

# LEF File for Accumulated Process Antenna Effects at the Boundary Pins
# *********************************************************************

VERSION 5.5 ;
NAMESCASESENSITIVE ON ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;

MACRO fsm 
  PIN done 
    ANTENNADIFFAREA 0.7591 LAYER met2 ; 
    ANTENNAPARTIALMETALAREA 1.5231 LAYER met2 ;
    ANTENNAPARTIALMETALSIDEAREA 7.5075 LAYER met2 ;
  END done
  PIN load_rega 
    ANTENNADIFFAREA 1.9191 LAYER met2 ; 
    ANTENNAPARTIALMETALAREA 1.6764 LAYER met2 ;
    ANTENNAPARTIALMETALSIDEAREA 8.372 LAYER met2 ;
  END load_rega
  PIN load_regc 
    ANTENNADIFFAREA 1.9191 LAYER met2 ; 
    ANTENNAPARTIALMETALAREA 1.6666 LAYER met2 ;
    ANTENNAPARTIALMETALSIDEAREA 8.225 LAYER met2 ;
  END load_regc
  PIN load_regb 
    ANTENNAPARTIALMETALAREA 0.5802 LAYER met1 ;
    ANTENNAPARTIALMETALSIDEAREA 2.793 LAYER met1 ;
    ANTENNAPARTIALCUTAREA 0.0225 LAYER via1 ;
    ANTENNAPARTIALMETALAREA 0.2365 LAYER met2 ;
    ANTENNAPARTIALMETALSIDEAREA 1.0115 LAYER met2 ;
    ANTENNAPARTIALCUTAREA 0.04 LAYER via2 ;
    ANTENNADIFFAREA 1.9191 LAYER met3 ; 
    ANTENNAPARTIALMETALAREA 1.6488 LAYER met3 ;
    ANTENNAPARTIALMETALSIDEAREA 9.264 LAYER met3 ;
  END load_regb
  PIN load_regd 
