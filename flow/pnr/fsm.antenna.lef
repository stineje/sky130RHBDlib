    ANTENNAPARTIALMETALSIDEAREA 13.6955 LAYER met2 ;
  END load_regd
  PIN load_regr 
    ANTENNADIFFAREA 0.7591 LAYER met2 ; 
    ANTENNAPARTIALMETALAREA 2.9524 LAYER met2 ;
    ANTENNAPARTIALMETALSIDEAREA 14.644 LAYER met2 ;
    ANTENNAMODEL OXIDE1 ;
    ANTENNAGATEAREA 0.9775 LAYER met2 ; 
    ANTENNAMAXAREACAR 4.19887 LAYER met2 ;
    ANTENNAMAXSIDEAREACAR 18.8368 LAYER met2 ;
    ANTENNAMAXCUTCAR 0.0525831 LAYER via2 ;
  END load_regr
  PIN sel_muxr 
    ANTENNADIFFAREA 0.7591 LAYER met2 ; 
    ANTENNAPARTIALMETALAREA 2.9426 LAYER met2 ;
    ANTENNAPARTIALMETALSIDEAREA 14.497 LAYER met2 ;
    ANTENNAMODEL OXIDE1 ;
    ANTENNAGATEAREA 0.9775 LAYER met2 ; 
    ANTENNAMAXAREACAR 3.01033 LAYER met2 ;
    ANTENNAMAXSIDEAREACAR 14.8307 LAYER met2 ;
  END sel_muxr
  PIN load_regs 
    ANTENNAPARTIALMETALAREA 0.6201 LAYER met1 ;
    ANTENNAPARTIALMETALSIDEAREA 2.9925 LAYER met1 ;
    ANTENNAPARTIALCUTAREA 0.0225 LAYER via1 ;
    ANTENNAPARTIALMETALAREA 0.1725 LAYER met2 ;
    ANTENNAPARTIALMETALSIDEAREA 0.6405 LAYER met2 ;
    ANTENNAPARTIALCUTAREA 0.04 LAYER via2 ;
    ANTENNADIFFAREA 0.7591 LAYER met3 ; 
    ANTENNAPARTIALMETALAREA 1.6488 LAYER met3 ;
    ANTENNAPARTIALMETALSIDEAREA 9.264 LAYER met3 ;
    ANTENNAMODEL OXIDE1 ;
    ANTENNAGATEAREA 0.9775 LAYER met3 ; 
    ANTENNAMAXAREACAR 4.64964 LAYER met3 ;
    ANTENNAMAXSIDEAREACAR 21.7637 LAYER met3 ;
    ANTENNAMAXCUTCAR 0.0935038 LAYER via3 ;
  END load_regs
  PIN sel_muxa[2] 
    ANTENNADIFFAREA 1.3391 LAYER met2 ; 
    ANTENNAPARTIALMETALAREA 2.8502 LAYER met2 ;
    ANTENNAPARTIALMETALSIDEAREA 14.035 LAYER met2 ;
    ANTENNAMODEL OXIDE1 ;
    ANTENNAGATEAREA 0.9775 LAYER met2 ; 
    ANTENNAMAXAREACAR 3.70522 LAYER met2 ;
    ANTENNAMAXSIDEAREACAR 16.3023 LAYER met2 ;
    ANTENNAMAXCUTCAR 0.0525831 LAYER via2 ;
  END sel_muxa[2]
  PIN sel_muxa[1] 
    ANTENNAPARTIALMETALAREA 0.5326 LAYER met1 ;
    ANTENNAPARTIALMETALSIDEAREA 2.555 LAYER met1 ;
    ANTENNAPARTIALCUTAREA 0.0225 LAYER via1 ;
    ANTENNAPARTIALMETALAREA 0.2869 LAYER met2 ;
    ANTENNAPARTIALMETALSIDEAREA 1.2635 LAYER met2 ;
    ANTENNAPARTIALCUTAREA 0.04 LAYER via2 ;
    ANTENNADIFFAREA 1.9191 LAYER met3 ; 
    ANTENNAPARTIALMETALAREA 2.5668 LAYER met3 ;
    ANTENNAPARTIALMETALSIDEAREA 14.16 LAYER met3 ;
